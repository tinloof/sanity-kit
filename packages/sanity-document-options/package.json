{
	"name": "@tinloof/sanity-document-options",
	"version": "3.0.0",
	"description": "",
	"keywords": [
		"sanity",
		"sanity-plugin"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/tinloof/sanity-kit.git",
		"directory": "packages/sanity-document-options"
	},
	"license": "MIT",
	"author": "Tinloof",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist",
		"sanity.json",
		"v2-incompatible.js"
	],
	"scripts": {
		"build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"link-watch": "plugin-kit link-watch",
		"prepublishOnly": "npm run build",
		"watch": "pkg-utils watch --strict",
		"dev": "npm run watch",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "node --test test/*.test.mjs"
	},
	"sanityPlugin": {
		"verifyPackage": {
			"eslintImports": false,
			"esmOnly": false,
			"oxfmt": false,
			"oxlint": false,
			"nodeEngine": false
		}
	},
	"dependencies": {
		"@sanity/icons": "^5.2.1",
		"@sanity/incompatible-plugin": "^1.0.5",
		"@sanity/orderable-document-list": "^2.0.23",
		"pluralize": "^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@sanity/pkg-utils": "^12.3.4",
		"@sanity/plugin-kit": "^10.0.9",
		"@tinloof/sanity-extends": "workspace:*",
		"@types/pluralize": "^0.0.33",
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sanity": "6.13.1",
		"styled-components": "^6.5.3",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.80.0"
	},
	"peerDependencies": {
		"@tinloof/sanity-extends": "workspace:*",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sanity": "^6.12.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"import": "./dist/index.js",
				"require": "./dist/index.cjs",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"module": "./dist/index.js"
}
