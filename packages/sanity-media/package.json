{
	"name": "@tinloof/sanity-media",
	"version": "1.0.1",
	"description": "Media management plugin for Sanity with S3-compatible storage support",
	"license": "MIT",
	"author": "Tinloof",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm run build",
		"test": "node --test test/*.test.mjs"
	},
	"sideEffects": false,
	"keywords": [
		"sanity",
		"sanity-plugin",
		"media",
		"s3",
		"r2",
		"storage"
	],
	"devDependencies": {
		"@sanity/icons": "^5.2.3",
		"@sanity/ui": "^4.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "6.17.0",
		"styled-components": "^6.5.3",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2"
	},
	"peerDependencies": {
		"@sanity/icons": "^5.2.3",
		"@sanity/ui": "^4.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "^6.17.0",
		"styled-components": "^6.5.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@aws-sdk/s3-request-presigner": "^3.1146.0",
		"@sanity/studio-secrets": "^4.0.20",
		"swr": "^2.5.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tinloof/sanity-kit.git",
		"directory": "packages/sanity-media"
	},
	"bugs": {
		"url": "https://github.com/tinloof/sanity-kit/issues"
	},
	"homepage": "https://github.com/tinloof/sanity-kit/packages/sanity-media#readme"
}
