{
	"name": "@tinloof/sanity-studio",
	"version": "2.0.2",
	"description": "A collection of Sanity studio plugins, fields, and components",
	"keywords": [
		"sanity",
		"sanity-plugin"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/tinloof/sanity-kit.git",
		"directory": "packages/sanity-studio"
	},
	"license": "MIT",
	"type": "module",
	"author": "Tinloof",
	"scripts": {
		"build": "pkg build --strict --check --clean",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"link-watch": "plugin-kit link-watch",
		"prepublishOnly": "npm run build",
		"watch": "pkg-utils watch --strict",
		"dev": "run-s watch",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.mjs"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"sanityPlugin": {
		"verifyPackage": {
			"tsconfig": false,
			"sanityV2Json": false,
			"tsc": false,
			"eslintImports": false,
			"esmOnly": false,
			"oxfmt": false,
			"oxlint": false,
			"nodeEngine": false
		}
	},
	"dependencies": {
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/icons": "^5.2.1",
		"@sanity/image-url": "^2.1.1",
		"@sanity/incompatible-plugin": "^1.0.5",
		"@sanity/orderable-document-list": "^2.0.23",
		"@sanity/ui": "^4.2.0",
		"@sanity/util": "6.13.1",
		"@tanstack/react-virtual": "^3.14.11",
		"@tinloof/sanity-web": "workspace:*",
		"lodash": "^4.18.1",
		"nanoid": "^6.0.1",
		"react-rx": "^6.1.0",
		"use-debounce": "^10.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@sanity/pkg-utils": "^12.3.4",
		"@sanity/plugin-kit": "^10.0.9",
		"@tinloof/sanity-extends": "workspace:*",
		"@types/lodash": "^4.17.25",
		"@types/react-is": "^19.2.0",
		"npm-run-all2": "^9.0.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"react-is": "^19.2.8",
		"rimraf": "^6.1.3",
		"sanity": "6.13.1",
		"styled-components": "^6.5.3",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.80.0"
	},
	"peerDependencies": {
		"@tinloof/sanity-extends": "workspace:*",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sanity": "^6.12.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"import": "./dist/index.js",
				"require": "./dist/index.cjs",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"inlinedDependencies": {
		"react-is": "19.2.8"
	}
}
