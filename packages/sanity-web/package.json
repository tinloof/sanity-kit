{
	"name": "@tinloof/sanity-web",
	"version": "2.0.2",
	"description": "Sanity-related utilities for web development",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/tinloof/sanity-kit.git",
		"directory": "packages/sanity-web"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.mjs",
			"require": "./dist/components/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"import": "./dist/components/*.mjs",
			"require": "./dist/components/*.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.mjs",
			"require": "./dist/utils/index.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.mjs",
			"require": "./dist/utils/*.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.mjs",
			"require": "./dist/types/index.js"
		},
		"./fragments": {
			"types": "./dist/fragments/index.d.ts",
			"import": "./dist/fragments/index.mjs",
			"require": "./dist/fragments/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.mjs"
	},
	"author": "Tinloof",
	"license": "ISC",
	"devDependencies": {
		"@portabletext/types": "^4.0.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/speakingurl": "^13.0.6",
		"next-sanity": "^13.3.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sanity": "6.13.1",
		"styled-components": "^6.5.3",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2"
	},
	"peerDependencies": {
		"next-sanity": "^13.3.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sanity": "^6.12.0"
	},
	"dependencies": {
		"@portabletext/react": "^8.0.1",
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/client": "^8.6.1",
		"@sanity/image-url": "^2.1.1",
		"groq": "6.13.1",
		"speakingurl": "^14.0.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
