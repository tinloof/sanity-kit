{
	"name": "@examples/blog-studio",
	"private": true,
	"version": "0.0.13",
	"main": "package.json",
	"scripts": {
		"dev": "sanity dev",
		"build": "sanity build ../blog-next/public/cms -y",
		"extract-types": "sanity schema extract --force",
		"typegen:watch": "sanity typegen generate --watch",
		"typegen": "pnpm run extract-types && sanity typegen generate",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"extract-types:watch": "sanity schema extract --force --watch --watch-patterns \"src/**/*.{ts,tsx}\""
	},
	"exports": {
		"./queries": "./src/queries/index.ts",
		"./types": "./sanity.types.ts"
	},
	"dependencies": {
		"@sanity/client": "^8.6.1",
		"@sanity/code-input": "^7.3.8",
		"@sanity/table": "^3.1.16",
		"@sanity/vision": "6.13.1",
		"@tinloof/sanity-document-options": "workspace:*",
		"@tinloof/sanity-extends": "workspace:*",
		"@tinloof/sanity-media": "workspace:*",
		"@tinloof/sanity-studio": "workspace:*",
		"groq": "6.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sanity": "6.13.1",
		"styled-components": "^6.5.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"@typescript/native": "npm:typescript@7.0.2"
	}
}
