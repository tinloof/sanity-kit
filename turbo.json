{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"lint": {},
		"check": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"cache": false
		},
		"typecheck": {},
		"@examples/hello-world-i18n-studio#typegen": {
			"outputs": ["schema.json", "sanity.types.ts"],
			"cache": true,
			"env": [
				"SANITY_STUDIO_DATASET",
				"SANITY_STUDIO_PROJECT_ID",
				"SANITY_STUDIO_API_VERSION"
			]
		},
		"@examples/hello-world-i18n-studio#typegen:watch": {
			"outputs": ["sanity.types.ts"],
			"cache": false,
			"persistent": true,
			"dependsOn": ["@examples/hello-world-i18n-studio#typegen"],
			"with": ["@examples/hello-world-i18n-studio#extract-types:watch"]
		},
		"@examples/hello-world-i18n-studio#build": {
			"dependsOn": ["@examples/hello-world-i18n-studio#typegen"],
			"outputs": ["../hello-world-i18n-next/public/cms/**", "./sanity/**"],
			"cache": true,
			"env": [
				"SANITY_STUDIO_DATASET",
				"SANITY_STUDIO_PROJECT_ID",
				"SANITY_STUDIO_API_VERSION"
			]
		},
		"@examples/hello-world-i18n-studio#dev": {
			"with": ["@examples/hello-world-i18n-studio#typegen:watch"],
			"persistent": true
		},
		"@examples/hello-world-i18n-next#build": {
			"dependsOn": ["@examples/hello-world-i18n-studio#build"],
			"cache": true
		},
		"@examples/blog-studio#typegen": {
			"outputs": ["schema.json", "sanity.types.ts"],
			"cache": true,
			"env": [
				"SANITY_STUDIO_DATASET",
				"SANITY_STUDIO_PROJECT_ID",
				"SANITY_STUDIO_API_VERSION"
			]
		},
		"@examples/blog-studio#typegen:watch": {
			"outputs": ["sanity.types.ts"],
			"cache": false,
			"persistent": true,
			"dependsOn": ["@examples/blog-studio#typegen"],
			"with": ["@examples/blog-studio#extract-types:watch"]
		},
		"@examples/blog-studio#build": {
			"dependsOn": ["@examples/blog-studio#typegen"],
			"outputs": ["../blog-next/public/cms/**", "./sanity/**"],
			"cache": true,
			"env": [
				"SANITY_STUDIO_DATASET",
				"SANITY_STUDIO_PROJECT_ID",
				"SANITY_STUDIO_API_VERSION"
			]
		},
		"@examples/blog-studio#dev": {
			"with": ["@examples/blog-studio#typegen:watch"],
			"persistent": true
		},
		"@examples/blog-next#build": {
			"dependsOn": ["@examples/blog-studio#build"],
			"cache": true
		},
		"@examples/blog-studio#extract-types:watch": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["@examples/blog-studio#typegen"]
		},
		"@examples/hello-world-i18n-studio#extract-types:watch": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["@examples/hello-world-i18n-studio#typegen"]
		},
		"@tinloof/sanity-web#test": {
			"cache": false,
			"dependsOn": ["@tinloof/sanity-web#build"]
		},
		"@tinloof/sanity-media#test": {
			"cache": false,
			"dependsOn": ["@tinloof/sanity-media#build"]
		},
		"@tinloof/sanity-studio#test": {
			"cache": false,
			"dependsOn": ["@tinloof/sanity-studio#build"]
		}
	}
}
